# Copy to .env for local `npm run dev` (never commit secrets)

CONTENT_GITHUB_TOKEN=
CONTENT_REPO=WeeTonyCooke/rosatos
CONTENT_BRANCH=main
PROPOSAL_SIGNING_SECRET=replace-me

# Cheap default via Netlify AI Gateway (OpenAI path). Swap freely.
OPS_AI_PROVIDER=openai
OPS_AI_MODEL=gpt-4o-mini

# Local only — never leave on once Identity is real
OPS_AUTH_BYPASS=1
VITE_OPS_AUTH_BYPASS=1

# Injected by Netlify AI Gateway after production deploy + AI enabled:
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
